{
  "name": "gha-taller-api",
  "version": "1.0.0",
  "description": "API de tareas para el taller de GitHub Actions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
